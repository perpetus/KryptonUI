# Build-only Windows SDK shader compiler. No runtime compilation or shader I/O.
file(GLOB KR_FXC_CANDIDATES "C:/Program Files (x86)/Windows Kits/10/bin/*/x64/fxc.exe")
list(SORT KR_FXC_CANDIDATES COMPARE NATURAL ORDER DESCENDING)
find_program(KR_FXC fxc HINTS ENV WindowsSdkVerBinPath)
if(NOT KR_FXC AND KR_FXC_CANDIDATES)
  list(GET KR_FXC_CANDIDATES 0 KR_FXC)
endif()
if(NOT KR_FXC)
  message(FATAL_ERROR "Windows SDK fxc is required to compile the glass shaders")
endif()
set(KR_GLASS_SHADER "${CMAKE_CURRENT_SOURCE_DIR}/src/windowsMain/shaders/glass.hlsl")
foreach(stage vertex pixel downsample blur)
  if(stage STREQUAL "vertex")
    set(entry VertexMain)
    set(profile vs_5_0)
  elseif(stage STREQUAL "pixel")
    set(entry GlassMain)
    set(profile ps_5_0)
  elseif(stage STREQUAL "downsample")
    set(entry DownsampleMain)
    set(profile ps_5_0)
  else()
    set(entry BlurMain)
    set(profile ps_5_0)
  endif()
  set(header "${KR_GENERATED_INCLUDE}/krypton/ui/design/glass_${stage}.generated.hpp")
  add_custom_command(OUTPUT "${header}"
    COMMAND "${CMAKE_COMMAND}" -E make_directory "${KR_GENERATED_INCLUDE}/krypton/ui/design"
    COMMAND "${KR_FXC}" /nologo /O3 /Ges /WX /T ${profile} /E ${entry}
            /Vn g_glass_${stage} /Fh "${header}" "${KR_GLASS_SHADER}"
    DEPENDS "${KR_GLASS_SHADER}" VERBATIM)
  list(APPEND KR_GLASS_SHADERS "${header}")
endforeach()
add_custom_target(kr_glass_shaders DEPENDS ${KR_GLASS_SHADERS})
add_dependencies(kr_shell kr_glass_shaders)
