    {
      "id": "fluent",
      "name": "Fluent System Icons",
      "package": "@fluentui/svg-icons",
      "version": "1.1.344",
      "integrity": "sha512-rasjaq4hBXzRS25pSY9gaqwY7NdvZJCz7G/rtpwF6mCmg2R+9TnySLhHbR+sOpkMP/IDDG28XvxRcNEQ/lJYoQ==",
      "tarball": "https://registry.npmjs.org/@fluentui/svg-icons/-/svg-icons-1.1.344.tgz",
      "license": "MIT",
      "license_url": "https://raw.githubusercontent.com/microsoft/fluentui-system-icons/main/LICENSE",
      "path": "package/icons/{name}_20_regular.svg"
    },
    {
      "id": "lucide",
      "name": "Lucide",
      "package": "lucide-static",
      "version": "1.61.0",
      "integrity": "sha512-yLAiQB3MWUJEstsEDAwenSA3m7vr1tdLvgnC16Q/XMxRRma0DWwMs8M2bWlvgShrIs1m2mWMJ+0AiahqQO4GrA==",
      "tarball": "https://registry.npmjs.org/lucide-static/-/lucide-static-1.61.0.tgz",
      "license": "ISC",
      "path": "package/icons/{name}.svg"
    },
    {
      "id": "phosphor",
      "name": "Phosphor Icons",
      "package": "@phosphor-icons/core",
      "version": "2.1.1",
      "integrity": "sha512-v4ARvrip4qBCImOE5rmPUylOEK4iiED9ZyKjcvzuezqMaiRASCHKcRIuvvxL/twvLpkfnEODCOJp5dM4eZilxQ==",
      "tarball": "https://registry.npmjs.org/@phosphor-icons/core/-/core-2.1.1.tgz",
      "license": "MIT",
      "path": "package/assets/regular/{name}.svg"
    },
    {
      "id": "tabler",
      "name": "Tabler Icons",
      "package": "@tabler/icons",
      "version": "3.49.0",
      "integrity": "sha512-l+GnSkFETx0U26icxv1VUFnxxiTqXfCcVRiRAnyMwibupM2S2L/hSaZ9gmSgz01rkrsH/93NvLsxykqdanc6lw==",
      "tarball": "https://registry.npmjs.org/@tabler/icons/-/icons-3.49.0.tgz",
      "license": "MIT",
      "path": "package/icons/outline/{name}.svg"
    },
    {
      "id": "radix",
      "name": "Radix Icons",
      "package": "@radix-ui/react-icons",
      "version": "1.3.2",
      "integrity": "sha512-fyQIhGDhzfc9pK2kH6Pl9c4BDJGfMkPqkyIgYDthyNYoNg3wVhoJMMh19WS4Up/1KMPFVpNsT2q3WmXn2N1m6g==",
      "tarball": "https://registry.npmjs.org/@radix-ui/react-icons/-/react-icons-1.3.2.tgz",
      "license": "MIT",
      "path": "package/dist/react-icons.esm.js"
    }
  ],
